<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><title>Réservations</title></head>
<body>
  <h1>Réservations</h1>
  <p>Connecté : <%= user.username %> (<%= user.email %>)</p>

  <a href="/dashboard">← Dashboard</a> |
  <a href="/reservations-page/new">+ Créer une réservation</a> |
  <a href="/logout">Logout</a>

  <hr>

  <table border="1" cellpadding="6">
    <thead>
      <tr>
        <th>Catway</th>
        <th>Client</th>
        <th>Bateau</th>
        <th>Début</th>
        <th>Fin</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% reservations.forEach(r => { %>
        <tr>
          <td><%= r.catwayNumber %></td>
          <td><%= r.clientName %></td>
          <td><%= r.boatName %></td>
          <td><%= new Date(r.startDate).toLocaleDateString() %></td>
          <td><%= new Date(r.endDate).toLocaleDateString() %></td>
          <td>
            <a href="/reservations-page/<%= r._id %>/edit">Modifier</a>
            <form action="/reservations-page/<%= r._id %>/delete" method="POST" style="display:inline;">
              <button type="submit">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
